gateway:
  mode: "__GATEWAY_MODE__"
  interface: "__LAB_INTERFACE__"
  lan_ip: "192.168.50.1"
  lan_prefix_len: 22
  upstream_interface: "__UPSTREAM_INTERFACE__"

dhcp:
  binary: "__DNSMASQ_BINARY__"
  enabled: __DHCP_ENABLED__
  range_start: "192.168.50.100"
  range_end: "192.168.51.200"
  lease_time: "30m"
  domain: "lab"
  bypass_gateway: "__DHCP_BYPASS_GATEWAY__"
  bypass_dns: "__DHCP_BYPASS_DNS__"

device_policy:
  file: "__DEVICE_POLICY_FILE__"

dns:
  listen: "192.168.50.1"
  port: 53
__DNS_UPSTREAM_LINE__
  ipv6: __DNS_IPV6__

mihomo:
  binary: "__MIHOMO_BINARY__"
  config: "__RUNTIME_DIR__/mihomo.yaml"
  profile_mode: "__MIHOMO_PROFILE_MODE__"
  profile: "__MIHOMO_PROFILE__"
  mixed_port: 17890
  # macOS transparent proxying uses transparent.mode: "tun"; redir must stay 0.
  redir_port: 0
  api_addr: "127.0.0.1:19090"
  secret: ""

pf:
  anchor_name: "com.apple/open_mihomo_gateway_lab"
  # PF TCP redirection is not supported on macOS; TUN is the transparent path.
  redirect_tcp_to: 0

transparent:
  mode: "__TRANSPARENT_MODE__"
  tun_device: "utun123"
  tun_stack: "mixed"
  tun_auto_route: true
  tun_auto_detect_interface: false
  tun_strict_route: false
  tun_ipv6: "__TUN_IPV6__"
  ipv6_shared_l2_ready: __IPV6_SHARED_L2_READY__
  ipv6_packet_broker_binary: "__IPV6_PACKET_BROKER_BINARY__"
  ipv6_packet_mtu: 1500

runtime:
  dir: "__RUNTIME_DIR__"
