+func hasOpenSurgePacketListener(listeners []map[string]any) bool {
+	for _, listener := range listeners {
+		if listener["type"] == "opensurge-packet" {
+			return true
+		}
+	}
+	return false
+}
+
 func parseIPV6(rawCfg *RawConfig) {
-	if !rawCfg.IPv6 || !verifyIP6() {
+	parseOpenSurgeIPv6(rawCfg, verifyIP6)
+}
+
+func parseOpenSurgeIPv6(rawCfg *RawConfig, nativeIPv6 func() bool) {
+	// OpenSurge's packet listener, DNS IPv6 and an explicit host TUN address
+	// are independent IPv6 choices. Do not erase them merely because the
+	// macOS host lacks a native IPv6 address.
+	if !rawCfg.IPv6 || (!rawCfg.DNS.IPv6 && !(rawCfg.Tun.Enable && len(rawCfg.Tun.Inet6Address) > 0) && !hasOpenSurgePacketListener(rawCfg.Listeners) && !nativeIPv6()) {
 		rawCfg.DNS.FakeIPRange6 = ""
 		rawCfg.Tun.Inet6Address = nil
 	}
 }
 
